# Copy to .env.local and adjust when working on a single service.
#
# By default the dev server proxies /api to the API Gateway on port 8080, which is how the
# deployed platform routes traffic. To develop against the user-service alone, point the proxy
# straight at it:
#
#   VITE_API_PROXY_TARGET=http://localhost:8083

# Where the dev server forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:8080

# Optional: bypass the proxy entirely and call an absolute user-service URL from the browser.
# Requires the origin below to be listed in securebank.user.cors.allowed-origins.
# VITE_USER_API_BASE=http://localhost:8083/api/v1/users
